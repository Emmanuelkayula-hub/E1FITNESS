# PostgreSQL connection string used for normal app queries. Locally:
# run `service postgresql start`, then create a database/user and point
# this at it. On a provider with connection pooling (Supabase, Neon),
# use the POOLED connection string here (e.g. Supabase's port-6543
# PgBouncer URL, with ?pgbouncer=true appended).
DATABASE_URL="postgresql://user:password@localhost:5432/ek_wealth?schema=public"

# Unpooled connection string used only for migrations (PgBouncer's
# transaction-pooling mode can't run them reliably). For a plain,
# non-pooled Postgres (like the local one above), this is the same
# value as DATABASE_URL. On Supabase, use the direct (port 5432)
# connection string here instead of the pooled one.
DIRECT_URL="postgresql://user:password@localhost:5432/ek_wealth?schema=public"

# The single user this deployment serves — must match a seeded User.email.
APP_USER_EMAIL="you@example.com"
