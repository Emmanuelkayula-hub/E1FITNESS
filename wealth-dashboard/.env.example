# PostgreSQL connection string. Locally: run `service postgresql start`,
# then create a database/user and point this at it. In production: your
# managed Postgres provider's connection string (Neon/Supabase/Vercel Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/ek_wealth?schema=public"

# The single user this deployment serves — must match a seeded User.email.
APP_USER_EMAIL="you@example.com"
